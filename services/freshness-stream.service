[Unit]
Description=Freshness Monitor – Pi Live Video Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/freshness-monitor

# ── Adjust the python path / venv if you use one ──────────────────────
# With venv:
#   ExecStart=/home/pi/freshness-monitor/venv/bin/python pi_client.py --stream --fps 15
# Without venv (system python3):
ExecStart=/usr/bin/python3 /home/pi/freshness-monitor/pi_client.py --stream --fps 15

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
