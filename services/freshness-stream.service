[Unit]
Description=Freshness Monitor – Pi Live Video Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sumit
WorkingDirectory=/home/sumit/Desktop

# ── Adjust the python path / venv if you use one ──────────────────────
# With venv:
#   ExecStart=/home/sumit/Desktop/venv/bin/python pi_client.py --stream --fps 15
# Without venv (system python3):
ExecStart=/usr/bin/python3 /home/sumit/Desktop/pi_client.py --stream --fps 15 --capture-every 7200

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
